// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

model User {
  id_user  String   @id @default(uuid()) @db.Uuid
  username String   @unique
  email    String   @unique
  fullName String?  @map("full_name")
  gender   String?  @default("") @map("gender")
  password String   @map("password")
  role     UserRole @default(user)
  batches  Batch[]

  @@map("users")
}

model Template {
  id_template    String   @id @default(uuid()) @db.Uuid
  name           String
  linkImage      String   @map("link_image")
  totalQuestions Int      @default(0) @map("total_questions")
  type           String   @default("")
  results        Result[]

  @@map("templates")
}

model Batch {
  batch_id    String        @id @default(uuid()) @map("batch_id") @db.Uuid
  name        String
  user        User          @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  id_user     String        @map("id_user") @db.Uuid
  result      Result?       @relation(fields: [result_id], references: [id_result], onDelete: SetNull)
  result_id   String?       @map("result_id") @db.Uuid
  total_tests Int           @default(0) @map("total_tests")
  time        DateTime      @default(now()) @map("time")
  details     BatchDetail[]

  @@map("batches")
}

model BatchDetail {
  id         String  @id @default(uuid()) @map("id") @db.Uuid
  batch_id   String  @map("batch_id") @db.Uuid
  batch      Batch   @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade)
  file_name  String  @map("file_name")
  student_id String? @map("student_id")
  test_code  String? @map("test_code")
  score      Float   @map("score")

  @@map("batch_details")
}

model Result {
  id_result      String         @id @default(uuid()) @map("result_id") @db.Uuid
  name           String         @default("Bộ đáp án")
  id_template    String         @map("form_id") @db.Uuid
  template       Template       @relation(fields: [id_template], references: [id_template], onDelete: Cascade)
  totalQuestions Int            @map("total_questions")
  details        ResultDetail[]
  batches        Batch[]

  @@map("results")
}

model ResultDetail {
  id        String @id @default(uuid()) @db.Uuid
  id_result String @map("result_id") @db.Uuid
  result    Result @relation(fields: [id_result], references: [id_result], onDelete: Cascade)
  question  Int
  answer    String

  @@map("results_detail")
}
