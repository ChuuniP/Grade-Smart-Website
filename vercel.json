{
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://grade-smart-website.onrender.com/api/:path*"
    },
    {
      "source": "/templates/:path*",
      "destination": "https://grade-smart-website.onrender.com/templates/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://grade-smart-website.onrender.com/uploads/:path*"
    }
  ]
}
